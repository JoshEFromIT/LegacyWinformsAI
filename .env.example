# Ollama Configuration
# Base URL for the Ollama API (use host.docker.internal from Docker, localhost for native)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use — set this to an Ollama model name OR leave it as the default.
# When using a custom GGUF file, this is overridden automatically with the
# registered model name (derived from the GGUF filename or OLLAMA_GGUF_MODEL_NAME).
OLLAMA_MODEL=llama3.2-vision

# Timeout in seconds for model inference (vision models can be slow on large images)
OLLAMA_TIMEOUT=300

# -------------------------------------------------------------------
# GGUF Model Configuration
# -------------------------------------------------------------------
# Drop a .gguf file into the models/ directory and it will be auto-detected.
# Or set an explicit path below:

# Path to a .gguf model file (absolute or relative to project root)
# If blank, the app auto-detects a single .gguf in the models/ directory.
OLLAMA_GGUF_PATH=

# (Optional) Custom name to register the GGUF model under in Ollama.
# If blank, the filename stem is used (e.g. "openai_gpt-oss-20b-q8_0").
OLLAMA_GGUF_MODEL_NAME=

# (Optional) Path to a vision projector .gguf file (for multimodal GGUF models).
# Auto-detected if a file matching *mmproj* or *projector* exists in models/.
OLLAMA_GGUF_PROJECTOR_PATH=

# Directory where .gguf model files are stored
MODELS_DIR=models

# Session storage directory
SESSIONS_DIR=sessions
