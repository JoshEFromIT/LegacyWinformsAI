# Ollama Configuration
# Base URL for the Ollama API (use host.docker.internal from Docker, localhost for native)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use — Qwen2.5-VL 7B is recommended for UI/OCR analysis.
# Run: ollama pull qwen2.5vl:7b
OLLAMA_MODEL=qwen2.5vl:7b

# Timeout in seconds for model inference
OLLAMA_TIMEOUT=300

# Keep the model loaded in Ollama memory between requests (avoids cold-start).
# Format: "10m", "1h", "0" (unload immediately), "-1" (never unload).
OLLAMA_KEEP_ALIVE=10m

# Max tokens per analysis response (2048 is enough for detailed UI analysis)
OLLAMA_MAX_TOKENS=2048

# Number of parallel Ollama requests (lower = less GPU contention)
OLLAMA_CONCURRENCY=3

# Max image dimension in pixels. Higher = better for small UI text.
# Qwen2.5-VL handles up to 2560px natively. 1920 preserves full-HD detail.
IMAGE_MAX_DIM=1920

# Frame deduplication threshold (0-64 hamming distance).
# Lower = stricter matching. 5 catches truly identical frames.
# Set to -1 to disable deduplication entirely.
DEDUP_THRESHOLD=5

# -------------------------------------------------------------------
# GGUF Model Configuration
# -------------------------------------------------------------------
# Drop a .gguf file into the models/ directory and it will be auto-detected.
# Or set an explicit path below:

# Path to a .gguf model file (absolute or relative to project root)
# If blank, the app auto-detects a single .gguf in the models/ directory.
OLLAMA_GGUF_PATH=

# (Optional) Custom name to register the GGUF model under in Ollama.
# If blank, the filename stem is used (e.g. "openai_gpt-oss-20b-q8_0").
OLLAMA_GGUF_MODEL_NAME=

# (Optional) Path to a vision projector .gguf file (for multimodal GGUF models).
# Auto-detected if a file matching *mmproj* or *projector* exists in models/.
OLLAMA_GGUF_PROJECTOR_PATH=

# Directory where .gguf model files are stored
MODELS_DIR=models

# Session storage directory
SESSIONS_DIR=sessions
